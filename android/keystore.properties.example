# Release signing credentials — COPY this example to `keystore.properties`
# (next to this file, i.e. android/keystore.properties) and fill in real values
# for local release builds. The real `keystore.properties` is git-ignored.
#
# In CI (GitHub Actions) this file is generated on the fly from repository
# secrets: KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD, and the keystore binary
# is decoded from KEYSTORE_BASE64 into `android/release.keystore`.
#
# storeFile is resolved relative to the `android/app/` module directory, so
# `../release.keystore` points at `android/release.keystore`.
storeFile=../release.keystore
storePassword=REPLACE_ME
keyAlias=REPLACE_ME
keyPassword=REPLACE_ME
